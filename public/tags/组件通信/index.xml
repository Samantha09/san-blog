			<item>
				<title>React 学习 Day 02：受控表单、DOM、组件通信与 Hooks</title>
				<link>http://localhost:1313/posts/react-%E5%AD%A6%E4%B9%A0-day-02%E5%8F%97%E6%8E%A7%E8%A1%A8%E5%8D%95dom%E7%BB%84%E4%BB%B6%E9%80%9A%E4%BF%A1%E4%B8%8E-hooks/</link>
